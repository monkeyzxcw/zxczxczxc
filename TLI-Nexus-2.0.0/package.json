{
  "name": "tli-nexus",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "test": "node --test test/*.test.mjs",
    "check": "node --check electron-main.mjs && node --check electron-preload.cjs && node --check overlay.js && node --check dashboard.js && node --check core/liveService.js && node --check core/buildAnalysis.js && node --check core/persistence.js && node --check core/farmAnalytics.js && node --check core/priceHistory.js && node --check core/hotkeys.js && node --check core/equipmentTracker.js && node --check core/gameLogEvents.js && node --check scripts/verify-release.mjs && node --check core/characterProfiles.js && node --check core/characterIntel.js && node --check core/characterReport.js && node --check core/snapshotHistory.js && node --check core/equipmentIntelligence.js && node --check core/itemObservation.js && node --check core/gameResourceCatalog.js",
    "build:desktop": "node scripts/verify-release.mjs",
    "release:check": "npm run check && npm test && npm run build:desktop",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "main": "electron-main.mjs",
  "description": "Torchlight: Infinite desktop companion with local Unreal resource catalog, evidence-based item intelligence, market and farming analytics",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.tlinexus.desktop",
    "productName": "TLI Nexus",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron-main.mjs",
      "electron-preload.cjs",
      "overlay.html",
      "overlay.js",
      "overlay.css",
      "dashboard.html",
      "dashboard.js",
      "dashboard.css",
      "core/**/*",
      "data/**/*",
      "assets/nexus-icon.png",
      "assets/nexus-icon.ico",
      "package.json",
      "README.md",
      "docs/RELEASE_NOTES_1.0.0.md",
      "docs/RELEASE_NOTES_1.0.1.md",
      "docs/RELEASE_NOTES_1.1.0.md",
      "docs/RELEASE_NOTES_1.1.1.md",
      "docs/RELEASE_NOTES_1.2.0.md",
      "docs/USER_ACCEPTANCE_CHECKLIST.md",
      "docs/RELEASE_NOTES_1.2.1.md",
      "docs/RELEASE_NOTES_1.3.0.md",
      "docs/RELEASE_NOTES_1.4.0.md",
      "docs/RELEASE_NOTES_2.0.0.md",
      "core/characterReport.js",
      "core/snapshotHistory.js",
      "docs/RELEASE_NOTES_2.1.0.md",
      "docs/RELEASE_NOTES_2.2.0.md",
      "docs/GAME_RESOURCE_EXTRACTION.md"
    ],
    "win": {
      "icon": "assets/nexus-icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "TLI-Nexus-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TLI Nexus",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "TLI-Nexus-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "TLI-Nexus-${version}-Portable-${arch}.${ext}"
    }
  }
}
